rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidStudent(data, userId) {
      return data.userId == userId &&
        data.year is string && data.year.size() > 0 && data.year.size() <= 30 &&
        data.roll is string && data.roll.size() > 0 && data.roll.size() <= 20 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.active is bool &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidAttendance(data, userId) {
      return data.userId == userId &&
        data.year is string && data.year.size() > 0 && data.year.size() <= 30 &&
        data.date is string && data.date.size() == 10 &&
        data.roll is string && data.roll.size() > 0 && data.roll.size() <= 20 &&
        data.status is string && (data.status == 'P' || data.status == 'A') &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidSettings(data, userId) {
      return data.userId == userId &&
        (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 30)) &&
        (!('appTheme' in data) || (data.appTheme is string && data.appTheme in ['SYSTEM', 'LIGHT', 'DARK'])) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /students/{studentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidStudent(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidStudent(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /attendance/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAttendance(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidAttendance(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSettings(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidSettings(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
